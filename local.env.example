# Copy to local.env (gitignored) on each Mac and fill in.
NODE_NAME=laptop                   # this machine's name in hosts.conf
LIGHTHOUSE_HOST=home.example.com   # DDNS name of the home router
LIGHTHOUSE_PORT=443                # UDP port forwarded to the mini (443 survives most firewalls)
LIGHTHOUSE_LAN_IP=192.168.1.50     # mini's reserved LAN IP (NAT-loopback fallback at home)
SSH_USER=datdo                     # account allowed to SSH in over the mesh
CA_DIR="$HOME/.fleet-ca"           # CA private key location (mini only)
