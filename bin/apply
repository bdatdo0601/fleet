#!/usr/bin/env bash
# On any Mac in the fleet: install/update Nebula from this repo. Idempotent.
#   bin/apply [NAME]          (NAME defaults to NODE_NAME from local.env)
# First run on a new machine generates its key and a signing request; once the
# signed cert is in the repo, the next run installs config and (re)starts Nebula.
# shellcheck source=lib.sh
. "$(dirname "$0")/lib.sh"
load_env

name="${1:-${NODE_NAME:-}}"
[ -n "$name" ] || die "usage: bin/apply NAME (or set NODE_NAME in local.env)"
[ "$(uname -s)" = Darwin ] || die "only macOS is supported so far"

kind="$(host_field "$name" 3)"
tmpl="$(template_for_kind "$kind")" || die "$name is kind '$kind'; only lighthouse/mac run bin/apply"
[ "$kind" = lighthouse ] || require_vars LIGHTHOUSE_HOST LIGHTHOUSE_LAN_IP

command -v nebula >/dev/null || { info "installing nebula"; brew install nebula; }
sudo mkdir -p "$NEBULA_ETC"

# 1. This machine's private key never leaves it; only the public half goes in the repo.
if ! sudo test -f "$NEBULA_ETC/host.key"; then
  info "generating Nebula key for $name"
  tmp="$(mktemp -d)"
  sudo nebula-cert keygen -out-key "$NEBULA_ETC/host.key" -out-pub "$tmp/host.pub"
  sudo chmod 600 "$NEBULA_ETC/host.key"
  sudo install -m 644 -o "$(id -un)" "$tmp/host.pub" "$REPO_ROOT/pki/requests/$name.pub"
  sudo rm -rf "$tmp"
fi

# 2. Need a signed cert. The CA holder can sign its own request directly.
cert="$REPO_ROOT/pki/certs/$name.crt"
if [ ! -f "$cert" ]; then
  if [ -f "$CA_DIR/ca.key" ]; then
    "$REPO_ROOT/bin/sign" "$name"
  else
    info "signing request written: pki/requests/$name.pub"
    cat <<EOF
Next:
  here:      git add pki/requests/$name.pub && git commit -m "fleet: request $name" && git push
  on mini:   git pull && bin/sign $name && git add pki/certs && git commit -m "fleet: sign $name" && git push
  here:      git pull && bin/apply
EOF
    exit 0
  fi
fi
[ -f "$REPO_ROOT/pki/ca.crt" ] || die "pki/ca.crt missing (run bin/ca-init on the mini)"

# 3. Validate in a root-only staging dir before touching the live config.
stage="$(sudo mktemp -d)"
trap 'sudo rm -rf "$stage"' EXIT
sudo cp "$REPO_ROOT/pki/ca.crt" "$stage/ca.crt"
sudo cp "$cert" "$stage/host.crt"
sudo cp "$NEBULA_ETC/host.key" "$stage/host.key"
render "$tmpl" "$stage" | sudo tee "$stage/config.yml" >/dev/null
sudo nebula -test -config "$stage/config.yml" >/dev/null ||
  die "config test failed (key/cert mismatch? re-sign with: bin/sign $name --force)"

# 4. Install and (re)start.
sudo install -m 644 "$REPO_ROOT/pki/ca.crt" "$NEBULA_ETC/ca.crt"
sudo install -m 644 "$cert" "$NEBULA_ETC/host.crt"
render "$tmpl" "$NEBULA_ETC" | sudo tee "$NEBULA_ETC/config.yml" >/dev/null

# The macOS application firewall (if on) must let nebula receive UDP. The Cellar
# path changes on `brew upgrade`, so this re-runs every apply.
alf=/usr/libexec/ApplicationFirewall/socketfilterfw
if [[ "$("$alf" --getglobalstate 2>/dev/null)" == *enabled* ]]; then
  bin="$(realpath "$(command -v nebula)")"
  sudo "$alf" --add "$bin" >/dev/null
  sudo "$alf" --unblockapp "$bin" >/dev/null
fi

sudo brew services restart nebula >/dev/null
info "$name is up as $(host_field "$name" 2) (log: /opt/homebrew/var/log/nebula.log)"
