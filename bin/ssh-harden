#!/bin/bash
# On a Mac you want to reach over SSH: key-only logins, accepted only from the mesh.
# (macOS sshd listens on every interface, so without this it is exposed on
# office/hotel Wi-Fi too.) Turn on Remote Login yourself in System Settings.
#   bin/ssh-harden [USER]      (default: you)
set -euo pipefail
user="${1:-$(id -un)}"
mesh="10.213.0.0/16"
conf=/etc/ssh/sshd_config.d/200-fleet.conf

tmp="$(mktemp)"
cat >"$tmp" <<EOF
# Managed by fleet/bin/ssh-harden. Key-only SSH, reachable only over the Nebula mesh.
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
AllowUsers ${user}@${mesh}
EOF
sudo install -m 644 "$tmp" "$conf"
rm -f "$tmp"
if ! sudo /usr/sbin/sshd -t; then
  sudo rm -f "$conf"
  echo "error: sshd rejected the config; removed $conf" >&2
  exit 1
fi
echo "==> installed $conf (AllowUsers ${user}@${mesh})"
echo "==> make sure System Settings > General > Sharing > Remote Login is on, and add your"
echo "    admin devices' SSH public keys to ~/.ssh/authorized_keys"
