#!/usr/bin/env bash
# On the CA holder (Mac mini): sign a device's public key.
#   bin/sign NAME [--force]
# Reads pki/requests/NAME.pub, writes pki/certs/NAME.crt using hosts.conf for the
# device's IP, groups and lifetime. --force replaces an existing cert (re-key).
# shellcheck source=lib.sh
. "$(dirname "$0")/lib.sh"
load_env

name="${1:-}"
[ -n "$name" ] || die "usage: bin/sign NAME [--force]"
force="${2:-}"

ip="$(host_field "$name" 2)"
groups="$(host_field "$name" 4)"
duration="$(host_field "$name" 5)"
pub="$REPO_ROOT/pki/requests/$name.pub"
out="$REPO_ROOT/pki/certs/$name.crt"

[ -f "$CA_DIR/ca.key" ] || die "no CA key at $CA_DIR/ca.key (run this on the CA holder)"
[ -f "$pub" ] || die "no request at pki/requests/$name.pub
  Mac:    run bin/apply on that machine, commit + push the .pub, git pull here
  mobile: save the public key shown by the Mobile Nebula app to that path"

if [ -f "$out" ]; then
  [ "$force" = "--force" ] || die "pki/certs/$name.crt exists (use --force to re-sign)"
  rm -f "$out"
fi

args=(sign -ca-key "$CA_DIR/ca.key" -ca-crt "$REPO_ROOT/pki/ca.crt"
  -name "$name" -networks "$ip/$MESH_PREFIX" -groups "$groups"
  -in-pub "$pub" -out-crt "$out")
[ "$duration" = "-" ] || args+=(-duration "$duration")
nebula-cert "${args[@]}"

info "signed $name ($ip, groups: $groups)"
if [ "$(host_field "$name" 3)" = mobile ]; then
  info "next: paste pki/certs/$name.crt and pki/ca.crt into the Mobile Nebula app; commit + push the cert"
else
  info "next: commit + push pki/certs/$name.crt, then on $name: git pull && bin/apply"
fi
