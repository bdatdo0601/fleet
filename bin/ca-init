#!/usr/bin/env bash
# One-time, on the Mac mini: create the fleet certificate authority.
# The private key goes to $CA_DIR (outside the repo, passphrase-encrypted);
# only the public ca.crt is committed.
# shellcheck source=lib.sh
. "$(dirname "$0")/lib.sh"
load_env

[ ! -f "$REPO_ROOT/pki/ca.crt" ] || die "pki/ca.crt already exists; the CA is initialised"
command -v nebula-cert >/dev/null || brew install nebula

mkdir -p "$CA_DIR"
chmod 700 "$CA_DIR"
info "creating CA (you'll be asked for a passphrase)"
nebula-cert ca -name fleet -duration 43800h -encrypt -networks "$MESH_CIDR" \
  -out-key "$CA_DIR/ca.key" -out-crt "$REPO_ROOT/pki/ca.crt"
chmod 600 "$CA_DIR/ca.key"

info "CA key: $CA_DIR/ca.key (back it up, e.g. 1Password; never commit it)"
info "next: commit + push pki/ca.crt, then bin/apply on this machine"
